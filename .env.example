# Copy to .env and set values. Used for local testing with Docker Postgres + one chain.

# Required. For local Docker: no TLS.
DB_CONNECTION_STRING=postgres://indexer:indexer@localhost:5432/indexer?sslmode=disable

# Optional. Defaults to config.toml. Use one chain for testing.
CONFIG_PATH=config.one-chain.toml

# Optional
RUST_LOG=info
